{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": null,
    "functions": {
        "api/**/*.js": {
            "includeFiles": "brand.config.json"
        }
    },
    "rewrites": [
        {
            "source": "/api/supabase/:path*",
            "destination": "/api/supabase-proxy"
        },
        {
            "source": "/api/admin",
            "destination": "/api/admin-handler"
        },
        {
            "source": "/api/admin/:subpath*",
            "destination": "/api/admin-handler?subpath=:subpath*"
        },
        {
            "source": "/api/session",
            "destination": "/api/session-handler"
        },
        {
            "source": "/api/session/:subpath*",
            "destination": "/api/session-handler?subpath=:subpath*"
        },
        {
            "source": "/api/analytics",
            "destination": "/api/analytics-handler"
        },
        {
            "source": "/api/analytics/:subpath*",
            "destination": "/api/analytics-handler?subpath=:subpath*"
        },
        {
            "source": "/api/deriv-otp/:accountId",
            "destination": "/api/deriv-otp/[accountId]"
        },
        {
            "source": "/((?!api/|api$).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors *"
                }
            ]
        }
    ]
}
