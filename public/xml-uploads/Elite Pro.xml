                        <statement name="ELSE">
                          <block type="variables_set" id="ep_set_pred_to_6_win">
                            <field name="VAR" id="ep_var_prediction">Prediction</field>
                            <value name="VALUE">
                              <block type="math_number" id="ep_num_6_win">
                                <field name="NUM">6</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="ep_set_strat_under_win">
                                <field name="VAR" id="ep_var_target_strat">target_strategy</field>
