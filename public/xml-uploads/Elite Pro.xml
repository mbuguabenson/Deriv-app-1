                            <field name="NOTIFICATION_SOUND">silent</field>
                            <value name="MESSAGE">
                              <shadow type="text" id="ep_sl_notif_sh">
                                <field name="TEXT">Stop Loss</field>
                              </shadow>
                              <block type="variables_get" id="ep_get_stop_text">
                                <field name="VAR" id="ep_var_text_stop">text3</field>
