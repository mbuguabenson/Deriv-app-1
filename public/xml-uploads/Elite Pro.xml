                            <next>
                              <block type="variables_set" id="ep_set_strat_over_win">
                                <field name="VAR" id="ep_var_target_strat">target_strategy</field>
                                <value name="VALUE">
                                  <block type="text" id="ep_txt_strat_over3">
                                    <field name="TEXT">OVER 3</field>
