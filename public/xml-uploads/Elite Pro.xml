                                        <field name="TEXT">💎 [ELITE PRO NEXT] Low Momentum -> Pre-loading UNDER 6 for Next Round</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="text_join" id="ep_join_loss_text">
            <field name="VARIABLE" id="ep_var_text_loss">text1</field>
            <statement name="STACK">
              <block type="text_statement" id="ep_loss_txt_stmt1">
                <value name="TEXT">
                  <shadow type="text" id="ep_loss_txt_sh1">
                    <field name="TEXT"></field>
                  </shadow>
                  <block type="text" id="ep_loss_label">
                    <field name="TEXT">⚠️ [ELITE PRO LOSS] Multiplier Recovery: $ </field>
                  </block>
                </value>
                <next>
                  <block type="text_statement" id="ep_loss_txt_stmt2">
                    <value name="TEXT">
                      <shadow type="text" id="ep_loss_txt_sh2">
                        <field name="TEXT"></field>
                      </shadow>
                      <block type="read_details" id="ep_read_loss_detail">
                        <field name="DETAIL_INDEX">4</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="notify" id="ep_loss_notify">
                <field name="NOTIFICATION_TYPE">error</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="ep_loss_notif_sh">
                    <field name="TEXT">Loss</field>
                  </shadow>
                  <block type="variables_get" id="ep_get_loss_text">
                    <field name="VAR" id="ep_var_text_loss">text1</field>
                  </block>
                </value>
                <next>
                  <block type="math_change" id="ep_apply_martingale_change">
                    <field name="VAR" id="ep_var_stake">Stake</field>
                    <value name="DELTA">
                      <shadow type="math_number" id="ep_change_num_sh">
                        <field name="NUM">1</field>
                      </shadow>
                      <block type="math_arithmetic" id="ep_calc_martingale">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <shadow type="math_number" id="ep_m1_sh">
                            <field name="NUM">1</field>
                          </shadow>
                          <block type="variables_get" id="ep_get_curr_stake_for_m">
                            <field name="VAR" id="ep_var_stake">Stake</field>
                          </block>
                        </value>
                        <value name="B">
                          <shadow type="math_number" id="ep_m2_sh">
                            <field name="NUM">1</field>
                          </shadow>
                          <block type="variables_get" id="ep_get_martingale_mult">
                            <field name="VAR" id="ep_var_martingale">Martingale Multiplier</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="controls_if" id="ep_loss_switch_direction">
                        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare" id="ep_cmp_curr_is_6">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="variables_get" id="ep_get_pred_for_loss_sw">
                                <field name="VAR" id="ep_var_prediction">Prediction</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="ep_num_6_loss_cmp">
                                <field name="NUM">6</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set" id="ep_switch_to_over3_loss">
                            <field name="VAR" id="ep_var_prediction">Prediction</field>
                            <value name="VALUE">
                              <block type="math_number" id="ep_num_3_loss">
                                <field name="NUM">3</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="ep_set_strat_over3_loss">
                                <field name="VAR" id="ep_var_target_strat">target_strategy</field>
                                <value name="VALUE">
                                  <block type="text" id="ep_txt_strat_over3_loss">
                                    <field name="TEXT">OVER 3</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="notify" id="ep_notify_rec_over3">
                                    <field name="NOTIFICATION_TYPE">warn</field>
                                    <field name="NOTIFICATION_SOUND">silent</field>
                                    <value name="MESSAGE">
                                      <shadow type="text" id="ep_rec_over3_sh">
                                        <field name="TEXT">🔄 [ELITE PRO REVERSAL] Switching to OVER 3 for Martingale Recovery</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="variables_set" id="ep_switch_to_under6_loss">
                            <field name="VAR" id="ep_var_prediction">Prediction</field>
                            <value name="VALUE">
                              <block type="math_number" id="ep_num_6_loss">
                                <field name="NUM">6</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="ep_set_strat_under6_loss">
                                <field name="VAR" id="ep_var_target_strat">target_strategy</field>
                                <value name="VALUE">
                                  <block type="text" id="ep_txt_strat_under6_loss">
                                    <field name="TEXT">UNDER 6</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="notify" id="ep_notify_rec_under6">
                                    <field name="NOTIFICATION_TYPE">warn</field>
                                    <field name="NOTIFICATION_SOUND">silent</field>
                                    <value name="MESSAGE">
                                      <shadow type="text" id="ep_rec_under6_sh">
                                        <field name="TEXT">🔄 [ELITE PRO REVERSAL] Switching to UNDER 6 for Martingale Recovery</field>
                                      </shadow>
                                    </value>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="text_join" id="ep_join_total_text">
            <field name="VARIABLE" id="ep_var_text_total">text2</field>
            <statement name="STACK">
              <block type="text_statement" id="ep_total_stmt1">
                <value name="TEXT">
                  <shadow type="text" id="ep_tot_sh1">
                    <field name="TEXT"></field>
                  </shadow>
                  <block type="text" id="ep_tot_label">
                    <field name="TEXT">📊 ELITE PRO Total Net Profit: $ </field>
                  </block>
                </value>
                <next>
                  <block type="text_statement" id="ep_total_stmt2">
                    <value name="TEXT">
                      <shadow type="text" id="ep_tot_sh2">
                        <field name="TEXT"></field>
                      </shadow>
                      <block type="total_profit" id="ep_read_total_profit"></block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="notify" id="ep_total_notify">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <shadow type="text" id="ep_tot_notif_sh">
                    <field name="TEXT">Total</field>
                  </shadow>
                  <block type="variables_get" id="ep_get_total_text">
                    <field name="VAR" id="ep_var_text_total">text2</field>
                  </block>
                </value>
                <next>
                  <block type="controls_if" id="ep_target_and_stop_if">
                    <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
                    <value name="IF0">
                      <block type="logic_compare" id="ep_cmp_stop_loss">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="total_profit" id="ep_tot_prof_for_sl"></block>
                        </value>
                        <value name="B">
                          <block type="math_single" id="ep_neg_stop_loss">
                            <field name="OP">NEG</field>
                            <value name="NUM">
                              <shadow type="math_number" id="ep_sl_neg_sh">
                                <field name="NUM">9</field>
                              </shadow>
                              <block type="variables_get" id="ep_get_sl_val">
                                <field name="VAR" id="ep_var_stop_loss">Stop Loss</field>
                              </block>
                            </value>
                          </block>
