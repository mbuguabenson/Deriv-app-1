  <block type="profithub_bot_lock" id="profithub_security_shield_root" deletable="false" movable="true" x="0" y="-120"></block>
  <block type="trade_definition" id="ep_trade_def_root" deletable="false" x="0" y="0">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="ep_market_opt" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ100V</field>
        <next>
          <block type="trade_definition_tradetype" id="ep_tradetype_opt" deletable="false" movable="false">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">overunder</field>
            <next>
              <block type="trade_definition_contracttype" id="ep_contracttype_opt" deletable="false" movable="false">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="ep_candle_opt" deletable="false" movable="false">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="ep_restartbuysell_opt" deletable="false" movable="false">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="ep_restartonerror_opt" deletable="false" movable="false">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="notify" id="ep_init_notify">
        <field name="NOTIFICATION_TYPE">info</field>
        <field name="NOTIFICATION_SOUND">silent</field>
        <value name="MESSAGE">
          <shadow type="text" id="ep_init_notify_msg">
            <field name="TEXT">⚡ ELITE PRO Bot Activated | Dual Analysis Engine (Trade OVER 3 &amp; UNDER 6)</field>
          </shadow>
        </value>
        <next>
          <block type="variables_set" id="ep_set_init_stake">
            <field name="VAR" id="ep_var_init_stake">Initial Stake</field>
            <value name="VALUE">
              <block type="math_number" id="ep_num_init_stake">
                <field name="NUM">0.35</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="ep_set_curr_stake">
                <field name="VAR" id="ep_var_stake">Stake</field>
                <value name="VALUE">
                  <block type="math_number" id="ep_num_curr_stake">
                    <field name="NUM">0.35</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="ep_set_expected_profit">
                    <field name="VAR" id="ep_var_expected_profit">Expected Profit</field>
                    <value name="VALUE">
                      <block type="math_number" id="ep_num_expected_profit">
                        <field name="NUM">10</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="ep_set_stop_loss">
                        <field name="VAR" id="ep_var_stop_loss">Stop Loss</field>
                        <value name="VALUE">
                          <block type="math_number" id="ep_num_stop_loss">
                            <field name="NUM">25</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="ep_set_martingale">
                            <field name="VAR" id="ep_var_martingale">Martingale Multiplier</field>
                            <value name="VALUE">
                              <block type="math_number" id="ep_num_martingale">
                                <field name="NUM">2.6</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="ep_set_pred_init">
                                <field name="VAR" id="ep_var_prediction">Prediction</field>
                                <value name="VALUE">
                                  <block type="math_number" id="ep_num_pred_init">
                                    <field name="NUM">6</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="ep_set_init_trend">
                                    <field name="VAR" id="ep_var_market_trend">Market Trend</field>
                                    <value name="VALUE">
                                      <block type="text" id="ep_txt_init_trend">
                                        <field name="TEXT">Initializing Analysis Radar...</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="ep_set_init_target_strat">
                                        <field name="VAR" id="ep_var_target_strat">target_strategy</field>
                                        <value name="VALUE">
                                          <block type="text" id="ep_txt_init_strat">
                                            <field name="TEXT">UNDER 6</field>
                                          </block>
                                        </value>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="ep_trade_options">
        <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="ep_dur_sh">
            <field name="NUM">1</field>
          </shadow>
          <block type="math_number" id="ep_dur_num">
            <field name="NUM">1</field>
          </block>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="ep_amt_sh">
            <field name="NUM">0.35</field>
          </shadow>
          <block type="variables_get" id="ep_amt_get">
            <field name="VAR" id="ep_var_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="ep_pred_sh" inline="true">
            <field name="NUM">6</field>
          </shadow>
          <block type="variables_get" id="ep_pred_get">
            <field name="VAR" id="ep_var_prediction">Prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>
  <block type="during_purchase" id="ep_during_purchase_root" collapsed="true" x="714" y="0">
