                    <next>
                      <block type="controls_if" id="ep_win_switch_setup">
                        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare" id="ep_cmp_win_high_digit">
                            <field name="OP">GTE</field>
                            <value name="A">
                              <block type="last_digit" id="ep_win_ld_chk"></block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="ep_win_5_num">
                                <field name="NUM">5</field>
