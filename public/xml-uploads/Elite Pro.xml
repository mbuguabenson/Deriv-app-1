                            <next>
                              <block type="text_statement" id="ep_stop_stmt2">
                                <value name="TEXT">
                                  <shadow type="text" id="ep_stop_sh2">
                                    <field name="TEXT"></field>
                                  </shadow>
                                  <block type="total_profit" id="ep_read_sl_total"></block>
