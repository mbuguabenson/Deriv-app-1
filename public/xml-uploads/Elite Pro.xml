                    </statement>
                    <value name="IF1">
                      <block type="logic_compare" id="ep_cmp_target_profit">
                        <field name="OP">GTE</field>
                        <value name="A">
                          <block type="total_profit" id="ep_tot_prof_for_tp"></block>
                        </value>
                        <value name="B">
                          <block type="variables_get" id="ep_get_tp_val">
                            <field name="VAR" id="ep_var_expected_profit">Expected Profit</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO1">
                      <block type="text_join" id="ep_join_target_text">
                        <field name="VARIABLE" id="ep_var_text_target">text4</field>
                        <statement name="STACK">
