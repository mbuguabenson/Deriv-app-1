                        <field name="NUM">3</field>
                      </block>
                    </value>
                    <next>
                      <block type="notify" id="ad_notify_reappear">
                        <field name="NOTIFICATION_TYPE">warn</field>
                        <field name="NOTIFICATION_SOUND">silent</field>
                        <value name="MESSAGE">
                          <shadow type="text" id="ad_notif_reappear_msg">
                            <field name="TEXT">⚠️ Target digit reappeared! Resetting confirmation countdown.</field>
                          </shadow>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="math_change" id="ad_decrement_ticks">
                <field name="VAR" id="ad_var_confirmation_ticks">Confirmation Ticks Remaining</field>
                <value name="DELTA">
                  <shadow type="math_number" id="ad_minus_1_sh">
                    <field name="NUM">-1</field>
                  </shadow>
                </value>
                <next>
                  <block type="controls_if" id="ad_check_ready_to_buy_if">
                    <value name="IF0">
                      <block type="logic_compare" id="ad_cmp_ticks_zero">
                        <field name="OP">LTE</field>
                        <value name="A">
                          <block type="variables_get" id="ad_get_ticks_val">
                            <field name="VAR" id="ad_var_confirmation_ticks">Confirmation Ticks Remaining</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="ad_num_zero">
                            <field name="NUM">0</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set" id="ad_reset_for_next_cycle">
                        <field name="VAR" id="ad_var_waiting">Waiting For Digit</field>
                        <value name="VALUE">
                          <block type="logic_boolean" id="ad_bool_true3">
                            <field name="BOOL">TRUE</field>
                          </block>
                        </value>
                        <next>
                          <block type="notify" id="ad_notify_entry">
                            <field name="NOTIFICATION_TYPE">success</field>
                            <field name="NOTIFICATION_SOUND">silent</field>
                            <value name="MESSAGE">
                              <shadow type="text" id="ad_notif_entry_msg">
                                <field name="TEXT">🚀 3 Ticks Clear! Poverty Hunter Differs Entry Triggered!</field>
                              </shadow>
                            </value>
                            <next>
                              <block type="purchase" id="ad_exec_purchase_diff">
                                <field name="PURCHASE_LIST">DIGITDIFF</field>
                                <field name="FAST_EXECUTION">TRUE</field>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
